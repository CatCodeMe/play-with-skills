# AI Provider Configuration
# 支持的提供商: openai, deepseek, qwen, zhipu
AI_PROVIDER=deepseek

# API Keys (根据选择的提供商配置)
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx
QWEN_API_KEY=sk-xxx
ZHIPU_API_KEY=xxx

# Database
DATABASE_URL=sqlite+aiosqlite:///./petpick.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
